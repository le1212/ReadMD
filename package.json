{
  "name": "readmd",
  "version": "0.4.1",
  "description": "ReadMD - 本地 Markdown 阅读与编辑工具",
  "main": "electron/main.js",
  "author": "ReadMD contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "electron",
    "vditor",
    "desktop",
    "windows"
  ],
  "scripts": {
    "postinstall": "node scripts/prepare-vditor.js",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "26.15.3",
    "vditor": "4.0.1"
  },
  "build": {
    "appId": "com.readmd.app",
    "productName": "ReadMD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "docs/assets/logo.png",
      "!**/*.map"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ReadMD-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/openai-compatible": "3.0.75",
    "ai": "7.0.148",
    "diff": "9.0.0",
    "docx": "9.13.0",
    "jszip": "3.10.1",
    "node-html-parser": "9.0.5",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  }
}
